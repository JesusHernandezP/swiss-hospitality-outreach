    {
      "parameters": {
        "jsCode": "const maxDaily = parseInt($env.MAX_DAILY_SENDS || '30', 10);\nconst today = new Date().toISOString().split('T')[0];\nconst events = $input.all().map(i => i.json);\n\nconst sentToday = events.filter(e => e.timestamp && e.timestamp.startsWith(today)).length;\n\nif (sentToday >= maxDaily) {\n  return [{ json: { proceed: false, reason: `Max daily sends reached (${sentToday}/${maxDaily})` } }];\n}\n\nreturn [{ json: { proceed: true, remaining: maxDaily - sentToday } }];"
      },
