    {
      "parameters": {
        "jsCode": "const inputItem = $input.first();\nconst data = inputItem ? inputItem.json : {};\n\nlet isDryRun = true;\ntry {\n  const dryRunNode = $('If DRY_RUN').first();\n  if (dryRunNode && dryRunNode.json) {\n    isDryRun = dryRunNode.json.dry_run !== undefined ? dryRunNode.json.dry_run : true;\n  }\n} catch(e) {}\n\nlet messageId = data.message_id || data.id || 'unknown';\nconst now = new Date().toISOString();\nconst prepEmail = $('Prepare Email').first() ? $('Prepare Email').first().json : {};\n\nconst event = {\n  event_id: 'evt-' + Date.now(),\n  timestamp: now,\n  workflow: 'WF-05 Outreach Sender',\n  entity_type: 'CONTACT',\n  entity_id: data.contact_id || prepEmail.contact_id || 'unknown',\n  event_type: 'EMAIL_SENT',\n  details_json: JSON.stringify({ message_id: messageId, dry_run: isDryRun })\n};\n\nreturn [{ json: event }];"
      },
