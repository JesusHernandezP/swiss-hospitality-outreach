      "id": "schedule-trigger",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [240, 300]
    },
    {
      "parameters": {
        "jsCode": "const now = new Date();\nconst estTime = new Date(now.toLocaleString('en-US', { timeZone: $env.TIMEZONE || 'Europe/Madrid' }));\nconst hour = estTime.getHours();\nconst minute = estTime.getMinutes();\nconst timeNum = hour + (minute / 60);\n\nconst startStr = $env.SEND_WINDOW_START || '08:30';\nconst endStr = $env.SEND_WINDOW_END || '18:30';\n\nconst startNum = parseInt(startStr.split(':')[0]) + (parseInt(startStr.split(':')[1] || 0) / 60);\nconst endNum = parseInt(endStr.split(':')[0]) + (parseInt(endStr.split(':')[1] || 0) / 60);\n\n// Check if enabled or dry_run\nconst enabled = String($env.OUTREACH_ENABLED).toLowerCase() === 'true';\nconst dryRun = String($env.DRY_RUN).toLowerCase() === 'true';\n\n// Day of week (0=Sun, 6=Sat)\nconst day = estTime.getDay();\nconst isWeekend = day === 0 || day === 6;\n\n// Logic for window (bypassed in dry_run if manually testing)\nconst inWindow = timeNum >= startNum && timeNum <= endNum && !isWeekend;\nconst canSend = dryRun || (enabled && inWindow);\n\nreturn [{\n  json: {\n    can_send: canSend,\n    dry_run: dryRun,\n    reason: dryRun ? 'DRY_RUN mode active' : (!enabled ? 'Outreach Disabled' : (!inWindow ? 'Out of sending window or weekend' : 'OK'))\n  }\n}];"
      },
