      "parameters": {
        "jsCode": "const items = $input.all();\nif (items.length === 0) return [];\n\n// We only send ONE email per execution to spread them out.\nconst target = items[0].json;\nconst dryRun = $('Check Conditions').first().json.dry_run;\n\n// We need to fetch hotel details too, so we pass the hotel_id\nreturn [{\n  json: {\n    contact: target,\n    dry_run: dryRun\n  }\n}];"
      },
